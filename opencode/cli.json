{
  "$schema": "https://opencode.ai/v2/cli.json",
  "tabs": {
    "mode": "on",
    "scope": "global",
    "layout": "horizontal",
    "indicators": "status"
  },
  "scroll": {
    "speed": 1,
    "acceleration": false
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": true,
    "thinking": "hide",
    "grouping": "auto",
    "image_preview": true,
    "tps": true,
    "markdown": "rendered",
    "new_location": "launch",
    "permissions": "prompt"
  },
  "prompt": {
    "editor": true,
    "paste": "compact",
    "image_preview": true
  },
  "terminal": {
    "title": true,
    "copy": "select"
  },
  "attention": {
    "notifications": true,
    "sound": false,
    "volume": 0.4
  },
  "debug": {
    "devtools": false,
    "timing": false,
    "turn_tokens": false
  },
  "theme": {
    "name": "system"
  },
  "diffs": {
    "tree": true
  },
  "plugins": [
    "-opencode.prompt.footer"
  ]
}
